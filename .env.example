# ─── Copy to server/.env and fill in. Never commit real secrets. ───────────────
NODE_ENV=development
PORT=4000
# MongoDB 6+ running as a replica set (Prisma needs transactions). Easiest: free MongoDB Atlas cluster —
# Atlas → Connect → Drivers → copy the URI and add the database name (/hotel) before the "?":
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hotel?retryWrites=true&w=majority"
# Local single-node replica set (docker run -p 27017:27017 mongo:7 --replSet rs0, then rs.initiate()):
DATABASE_URL="mongodb://localhost:27017/hotel?replicaSet=rs0&directConnection=true"
# Public site URL (used in emails & CORS) and API base URL
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-0123456789
SESSION_TTL_DAYS=14
# Number of reverse proxies in front of the API (for correct client IPs / rate limits)
TRUST_PROXY=1
# Serve the built web app from the API process (single-container deploys)
SERVE_WEB=false

# ─── Payments ────────────────────────────────────────────────────────────────
# sandbox = clearly-labelled TEST MODE, no money moves. razorpay = real gateway.
# Portfolio concept of a real hotel: while CONCEPT_DEMO=true only the sandbox provider is allowed.
CONCEPT_DEMO=true
PAYMENT_PROVIDER=sandbox
SANDBOX_PAYMENT_SECRET=change-me-sandbox-secret-0123456789
# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_* keys for test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → secret (events: payment.captured, payment.failed, refund.processed, refund.failed)
RAZORPAY_WEBHOOK_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
# log = store in the email_logs collection only (visible in Admin → Settings → Email outbox)
EMAIL_PROVIDER=log
EMAIL_FROM="Rambagh Palace concept <reservations@yourdomain.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=

# ─── Media storage ───────────────────────────────────────────────────────────
# local = ./uploads on the API server (use a persistent volume). cloudinary = CDN.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=12
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Ops ─────────────────────────────────────────────────────────────────────
JOBS_ENABLED=true
LOG_LEVEL=info
# Seed only: password for demo staff accounts (development)
SEED_STAFF_PASSWORD=
